{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://levier.dev/service-status/v1/schema.json",
  "title": "Levier service status overview v1",
  "description": "Aggregate dynamic status returned by GET /status. Fields are additive within status_version 1.",
  "type": "object",
  "required": [
    "status_version",
    "service",
    "as_of",
    "uptime_seconds",
    "build",
    "health",
    "daemons",
    "apps",
    "runs",
    "workflow"
  ],
  "properties": {
    "status_version": {"const": 1},
    "service": {"const": "levier"},
    "as_of": {"type": "string", "format": "date-time"},
    "uptime_seconds": {"type": "integer", "minimum": 0},
    "build": {
      "type": "object",
      "required": ["version", "commit"],
      "properties": {
        "version": {"type": "string"},
        "commit": {"type": "string"}
      }
    },
    "health": {
      "type": "object",
      "required": ["liveness", "readiness", "database"],
      "properties": {
        "liveness": {"enum": ["ok"]},
        "readiness": {"enum": ["ok", "degraded", "unknown"]},
        "database": {"enum": ["up", "down", "unknown"]}
      }
    },
    "daemons": {
      "type": "object",
      "required": ["connected", "healthy", "capacity", "used", "available", "by_runtime"],
      "properties": {
        "connected": {"type": "integer", "minimum": 0},
        "healthy": {"type": "integer", "minimum": 0},
        "capacity": {"type": "integer", "minimum": 0},
        "used": {"type": "integer", "minimum": 0},
        "available": {"type": "integer", "minimum": 0},
        "by_runtime": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/runtimeSummary"}
        }
      }
    },
    "apps": {
      "type": "object",
      "required": ["registered", "websocket_connections"],
      "properties": {
        "registered": {"type": "integer", "minimum": 0},
        "websocket_connections": {"type": "integer", "minimum": 0}
      }
    },
    "runs": {
      "type": "object",
      "required": ["total", "active", "by_status"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "active": {"type": "integer", "minimum": 0},
        "by_status": {
          "type": "object",
          "required": ["queued", "assigned", "running", "completed", "failed", "cancelled", "timeout"],
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["total", "pending", "leased", "done", "dead", "cancelled", "oldest_pending_seconds"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "leased": {"type": "integer", "minimum": 0},
        "done": {"type": "integer", "minimum": 0},
        "dead": {"type": "integer", "minimum": 0},
        "cancelled": {"type": "integer", "minimum": 0},
        "oldest_pending_seconds": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "runtimeSummary": {
      "type": "object",
      "required": ["connected", "healthy", "capacity", "used", "available"],
      "properties": {
        "connected": {"type": "integer", "minimum": 0},
        "healthy": {"type": "integer", "minimum": 0},
        "capacity": {"type": "integer", "minimum": 0},
        "used": {"type": "integer", "minimum": 0},
        "available": {"type": "integer", "minimum": 0}
      }
    }
  }
}
