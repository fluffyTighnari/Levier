# Levier — repository ignore rules.
# Copyright 2026 The Levier Authors.

# OS / IDE / sync metadata
.DS_Store
.idea/
.stfolder/
.stignore

# Local AI tool session state (screens, threads, skeletons) — never publish
.uinice/
.qta/

# Archived nested engine: read-only, keeps its own git history.
/workflow_engine/

# Build and runtime output
/bin/
/dist/
/data/
/logs/
/mw-daemon-check
*.db
*.sqlite
*.sqlite3

# Secrets and per-project locators
.env
.env.*
!.env.example
.levier.json

# Python
build/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv*/
.pytest_cache/

# Go
vendor/
/middleware

# Local verification evidence and historical reports
/docs/reports/

# Internal planning and development notes.
# Published documentation lives in site/docs/.
/docs/*_PLAN.md
/docs/ADAPTER_ROADMAP.md
/docs/CLI_ACTIONS.md
/docs/DX.md
/docs/SIMPLIFICATION.md
/docs/START_HERE.md
/docs/TODO.md
/docs/configue.txt
