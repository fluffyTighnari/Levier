/bin/
/dist/
/data/
/logs/
/mw-daemon-check
*.db
*.sqlite
*.sqlite3

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv*/
.pytest_cache/

# Go
vendor/
/middleware

