# Levier — local MVP environment template.
# Copy to .env and replace every change-me value before sharing the host.
# Never commit .env.

# PostgreSQL used by Levier and the demo.
LEVIER_DATABASE_URL=postgres://change-me:change-me@127.0.0.1:5432/levier?sslmode=disable
LEVIER_TEST_DATABASE_URL=postgres://change-me:change-me@127.0.0.1:5432/levier_test?sslmode=disable

# Legacy aliases: accepted for one release. Use the LEVIER_* names above.
# MIDDLEWARE_DATABASE_URL=postgres://change-me:change-me@127.0.0.1:5432/levier?sslmode=disable
# MIDDLEWARE_TEST_DATABASE_URL=postgres://change-me:change-me@127.0.0.1:5432/levier_test?sslmode=disable

# Admin token is only used to bootstrap/rotate the demo App.
# It must match http.admin_token in the Levier config.
LEVIER_ADMIN_TOKEN=admin-change-me
# MW_ADMIN_TOKEN=admin-change-me

# Optional: only needed for `make mvp-demo-react`.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
